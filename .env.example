# Copy to .env (never commit it) or export these in your shell.
# The pipeline and all scripts read credentials only from the environment.

# PostgreSQL connection used by optimized_pipeline.py and the .sh gates
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=challenge
PGPASSWORD=change-me

# SSH connection used by the service-layer runners
# (run_expansion_linux.py, benchmark_variant.py)
PGSSHPORT=22
PGSSHUSER=root
PGSSHPASSWORD=change-me

# Dataset generator (generate_database.py)
PG_KAGGLE_CHALLENGE_PASS=change-me
